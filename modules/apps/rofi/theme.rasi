* {
    font: "monospace 18";
    background-color: transparent;
    text-color: #ebdbb2;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location:       center;
    width:          520;
    border-radius:  24px;
    border:         2px;
    border-color:   #3c3836;
    background-color: #1d2021;
}

mainbox {
    padding:    12px;
    spacing:    8px;
}

inputbar {
    background-color:   #282828; /* bg0 */
    border-color:       #504945;
    border:             2px;
    border-radius:      16px;

    padding:            8px 16px;
    spacing:            8px;
    children:           [ entry ];
}

prompt {
    text-color: #d5c4a1;
}

entry {
    placeholder:        "Search";
    placeholder-color:  #bdae93;
    expand:             true;
}

/* Small status / error messages under the bar */
message {
    margin:             4px 0 0;
    border-radius:      12px;
    border-color:       #3c3836;
    border:             1px;
    background-color:   #282828;
}

textbox {
    padding:    6px 16px;
}

listview {
    background-color:   transparent;

    margin:             8px 0 0;
    lines:              10;
    columns:            1;
    fixed-height:       true;
    scrollbar:          true;
    scrollbar-width:    5px;
    spacing:            4px;
}

scrollbar {
    handle-width:       5px;
    handle-color:       #504945;
}

/* Rows */
element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  12px;
}

/* Unselected rows */
element normal normal {
    text-color: #ebdbb2;
    background-color: transparent;
}

/* Hovered row (mouse) */
element normal active,
element alternate active {
    background-color: rgba(80, 73, 69, 0.4);
    text-color: #ebdbb2;
}

/* Selected row (keyboard) */
element selected normal,
element selected active {
    background-color:   #504945;
    text-color:         #1d2021;
}

/* Icon + text */
element-icon {
    size:           1.1em;
    vertical-align: 0.5;
    margin:         0px 8px 0px 0px;
}

element-text {
    text-color: inherit;
}
