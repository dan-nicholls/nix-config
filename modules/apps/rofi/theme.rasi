configuration {
    modi: "drun,run,filebrowser,window";
    show-icons: true;
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";
}

* {
    font: "monospace 14";
    background-color: transparent;
    text-color: #ebdbb2;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location:       center;
    anchor: center;
    width:          520;
    border-radius:  24px;
    border:         2px;
    border-color:   #3c3836;
    background-color: #1d2021;
}

mainbox {
    padding:    30px;
    spacing:    10px;
}

inputbar {
    background-color:   #282828;
    border-color:       #504945;
    border:             2px;
    border-radius:      16px;

    padding:            8px 16px;
    spacing:            8px;
    children:           [ entry, mode-switcher ];
}

prompt {
    text-color: #d5c4a1;
}

entry {
    placeholder:        "Search";
    placeholder-color:  #bdae93;
    expand:             true;
}

/* Mode Switcher */
mode-switcher{
    enabled:                     true;
    spacing:                     6px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:       #3c3836;
    background-color:            transparent;
    text-color: #d5c4a1;
}

button {
    padding:                     5px 12px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:       #3c3836;
    background-color:   #282828;
    text-color:                  inherit;
    cursor:                      pointer;
}

button selected {
    background-color: rgba(80, 73, 69, 0.4);
    text-color: #ebdbb2;
}

/* Small status / error messages under the bar */
message {
    margin:             4px 0 0;
    border-radius:      12px;
    border-color:       #3c3836;
    border:             1px;
    background-color:   #282828;
}

textbox {
    padding:    6px 16px;
}

listview {
    background-color:   transparent;

    margin:             8px 0 0;
    lines:              10;
    columns:            1;
    fixed-height:       true;
    scrollbar:          true;
    scrollbar-width:    5px;
    spacing:            4px;
}

scrollbar {
    handle-width:       5px;
    handle-color:       #504945;
}

/* Rows */
element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  12px;
}

/* Unselected rows */
element normal normal {
    text-color: #ebdbb2;
    background-color: transparent;
}

/* Hovered row (mouse) */
element normal active,
element alternate active {
    background-color: rgba(80, 73, 69, 0.4);
    text-color: #ebdbb2;
}

/* Selected row (keyboard) */
element selected normal,
element selected active {
    background-color:   #504945;
    text-color:         #1d2021;
}

/* Icon + text */
element-icon {
    size:           1.1em;
    vertical-align: 0.5;
    margin:         0px 8px 0px 0px;
}

element-text {
    text-color: inherit;
}
